# Pitchside model settings. Copy to .env (git-ignored) and fill in. Real environment variables win over .env.
# No API keys: live calls authenticate with Microsoft Entra ID (DefaultAzureCredential, e.g. after `az login`).

# "fake" (default): offline canned replies, never calls Azure, never spends money.
# "foundry": live calls to the model deployments in your Microsoft Foundry project.
PITCHSIDE_LLM=fake

# Foundry *project* endpoint, format https://<resource-name>.services.ai.azure.com/api/projects/<project-name>
# Where to find it: Foundry portal (new experience) > open your project > Overview page > "Project endpoint" (copy).
# If the Overview page shows no project endpoint, it is a hub-based project; use a Foundry project instead.
FOUNDRY_ENDPOINT=

# "responses" (recommended) or "chat_completions" if the deployment does not support the Responses API.
# scripts/smoke_foundry.py tries Responses first and tells you which one works.
FOUNDRY_API=responses

# Model *deployment* names in that project, one per agent role (all GPT-6 Luna, see docs/DECISIONS.md entry 1).
MODEL_INTERPRETER=
MODEL_EXPLAINER=
MODEL_VERIFIER=
MODEL_PERSONALIZER=

# Price-table entry used for cost accounting (src/pitchside/llm/prices.py). Unknown names fail closed.
PITCHSIDE_PRICE_MODEL=gpt-6-luna

# Spending guards, enforced from the usage log before every model call. The match budget is per run of a match.
# Recording the final demo bundles: set PITCHSIDE_MATCH_BUDGET_USD=0.25, so no finding in a recorded run is
# downgraded to a template for budget reasons (the bundle manifest lists every budget fallback; there should be none).
PITCHSIDE_MATCH_BUDGET_USD=0.10
PITCHSIDE_MATCH_MAX_CALLS=200
PITCHSIDE_TOTAL_BUDGET_USD=10
# Model calls in flight at once, across all agents (keeps us under a low deployment quota).
PITCHSIDE_MAX_CONCURRENCY=4

# Per-attempt timeout (seconds) and retries for rate limits, timeouts, connection and 5xx errors.
LLM_TIMEOUT_S=20
LLM_MAX_RETRIES=3

# Token and cost log, one JSON record per attempt (runs/ is git-ignored). Live runs only: offline (fake) runs
# write their own log inside the run directory, so fake costs never count toward the live budgets.
PITCHSIDE_USAGE_LOG=runs/llm_usage.jsonl

# Reasoning effort sent with every Responses API call: off (send nothing), none, low, medium, high, xhigh, max.
# scripts/smoke_foundry.py reports whether the Luna deployment accepts it.
PITCHSIDE_REASONING_EFFORT=low

# Output-token cap per agent role. Reasoning tokens count toward it, so it sits well above the JSON size.
# A reply cut off at the cap is retried once at twice the cap, then the role falls back to a template.
PITCHSIDE_MAX_OUTPUT_INTERPRETER=1500
PITCHSIDE_MAX_OUTPUT_EXPLAINER=3000
PITCHSIDE_MAX_OUTPUT_VERIFIER=1500
PITCHSIDE_MAX_OUTPUT_PERSONALIZER=4000

# Narrative languages (comma-separated). "en" is required; each code needs a phrase table in
# src/pitchside/agents/languages.py. Adding a language = one phrase table + one entry here.
PITCHSIDE_LANGUAGES=en,es
